# AI 录音 · PC 云 API 版 —— 第三方服务密钥模板
# 用法：cp .env.example .env，然后填入真实值（.env 已 gitignore，不会提交）

# ----- 免费版：硅基流动 SenseVoiceSmall（OpenAI 兼容）-----
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- 主用模型：智谱 BigModel（VLM glm-4.6v-flash + LLM glm-4.7-flash）-----
BIGMODEL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_VLM_MODEL=glm-4.6v-flash
BIGMODEL_LLM_MODEL=glm-4.7-flash

# ----- 阿里云百炼（实时版 + 专业版 Pro + VLM 备用 Qwen-VL-Max 共用）-----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- 备用文本整理 LLM：DeepSeek -----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- 专业版 Lite：火山引擎豆包录音文件识别 2.0 -----
VOLC_APP_ID=xxxxxxxxxx
VOLC_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOLC_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- 服务器音频托管（火山 Lite 版用：SFTP 上传后 HTTP 暴露）-----
AUDIO_HOST_HOST=8.130.23.56
AUDIO_HOST_PORT=22
AUDIO_HOST_USER=root
AUDIO_HOST_REMOTE_DIR=/var/www/airecorder/recordings
AUDIO_HOST_PUBLIC_BASE=http://8.130.23.56/airecorder/recordings
